# 复制为 .env 后按需修改
#
# 后端通过这三个环境变量对接任意 OpenAI 兼容端点。

# API 密钥
OPENAI_API_KEY=sk-not-configured

# 接口根地址（默认使用国内可直连的 DeepSeek 官方端点）
#   DeepSeek    https://api.deepseek.com             （默认，需在 platform.deepseek.com 充值）
#   中转站      https://api.li1023.com
#   阿里云百炼   https://dashscope.aliyuncs.com/compatible-mode
#   OpenAI      https://api.openai.com            （国内需代理）
#   Ollama      http://localhost:11434
OPENAI_BASE_URL=https://api.deepseek.com

# 模型名，需要支持 function calling
# DeepSeek 官方可用模型：deepseek-flash（默认）、deepseek-v4-pro；用 /v1/models 查询账号实际可用列表
OPENAI_MODEL=deepseek-flash
